<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyVersion>2.4.1.0</AssemblyVersion>
    <!-- Linked production adapters target netstandard2.1, where the newer throw helpers are unavailable. -->
    <NoWarn>$(NoWarn);CA1510;CA1512;CA1513</NoWarn>
    <DefineConstants>$(DefineConstants);UDS_PERFORMANCE_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UltimateDuckovStatistics.Core\UltimateDuckovStatistics.Core.csproj" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\ReflectiveHarmonyPatcher.cs"
             Link="ProductionAdapters\ReflectiveHarmonyPatcher.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\RetryableHarmonyPatcherLease.cs"
             Link="ProductionAdapters\RetryableHarmonyPatcherLease.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeCallbackLifetime.cs"
             Link="ProductionAdapters\NativeCallbackLifetime.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeRunTerminalBoundary.cs"
             Link="ProductionAdapters\NativeRunTerminalBoundary.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeEquipmentSnapshotBuilder.cs"
             Link="ProductionAdapters\NativeEquipmentSnapshotBuilder.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeEquipmentAdapter.cs"
             Link="ProductionAdapters\NativeEquipmentAdapter.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeCombatEquipmentAssociationResolver.cs"
             Link="ProductionAdapters\NativeCombatEquipmentAssociationResolver.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeContainerAdapter.Publication.cs"
             Link="ProductionAdapters\NativeContainerAdapter.Publication.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeEconomyAdapter.cs"
             Link="ProductionAdapters\NativeEconomyAdapter.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\ItemUsePublication.cs"
             Link="ProductionAdapters\ItemUsePublication.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\UI\UiText.cs"
             Link="ProductionUI\UiText.cs" />
    <Compile Include="..\..\tools\FrameTimeAnalyzer\FrameTimeAnalysis.cs"
             Link="Performance\FrameTimeAnalysis.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\NativeHotPathDiagnostics.cs"
             Link="Performance\NativeHotPathDiagnostics.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\IncrementalPatchInspectionScheduler.cs"
             Link="Performance\IncrementalPatchInspectionScheduler.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\ReferenceScopeStack.cs"
             Link="Performance\ReferenceScopeStack.cs" />
    <Compile Include="..\..\src\UltimateDuckovStatistics\Adapters\DeferredCheckpointWriter.cs"
             Link="Performance\DeferredCheckpointWriter.cs" />
  </ItemGroup>
</Project>
