<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>UltimateDuckovStatistics</AssemblyName>
    <RootNamespace>UltimateDuckovStatistics</RootNamespace>
    <Description>Duckov adapter and native UI for Ultimate Duckov Statistics.</Description>
    <DuckovPath Condition="'$(DuckovPath)' == ''">$(DUCKOV_PATH)</DuckovPath>
    <DuckovManagedPath>$(DuckovPath)\Duckov_Data\Managed</DuckovManagedPath>
    <DefineConstants Condition="'$(UDSPerformanceDiagnostics)' == 'true'">$(DefineConstants);UDS_PERFORMANCE_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimateDuckovStatistics.Core\UltimateDuckovStatistics.Core.csproj" />
    <Reference Include="TeamSoda.Duckov.Core" HintPath="$(DuckovManagedPath)\TeamSoda.Duckov.Core.dll" Private="false" />
    <Reference Include="ItemStatsSystem" HintPath="$(DuckovManagedPath)\ItemStatsSystem.dll" Private="false" />
    <Reference Include="TeamSoda.Duckov.Utilities" HintPath="$(DuckovManagedPath)\TeamSoda.Duckov.Utilities.dll" Private="false" />
    <Reference Include="Sirenix.OdinInspector.Attributes" HintPath="$(DuckovManagedPath)\Sirenix.OdinInspector.Attributes.dll" Private="false" />
    <Reference Include="Eflatun.SceneReference" HintPath="$(DuckovManagedPath)\Eflatun.SceneReference.dll" Private="false" />
    <Reference Include="UniTask" HintPath="$(DuckovManagedPath)\UniTask.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(DuckovManagedPath)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DuckovManagedPath)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(DuckovManagedPath)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(DuckovManagedPath)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(DuckovManagedPath)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(DuckovManagedPath)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(DuckovManagedPath)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(DuckovManagedPath)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="SodaLocalization" HintPath="$(DuckovManagedPath)\SodaLocalization.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateDuckovPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(DuckovPath)' == ''" Text="DUCKOV_PATH is required to build the Duckov adapter." />
    <Error Condition="!Exists('$(DuckovManagedPath)\TeamSoda.Duckov.Core.dll')" Text="Duckov managed assemblies were not found under $(DuckovManagedPath)." />
  </Target>
</Project>
